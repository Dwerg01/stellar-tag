            },
            "text_B3Fg9H": {
              "type": "text",
              "settings": {
                "text": "<p>StellarTag is an Apple-certified smart tracking solution built specifically for businesses that want full control over valuable shipments while strengthening client relationships.bAs one of the few European companies officially certified by Apple to use the Find My technology, our tags leverage hundreds of millions of Apple devices worldwide to securely transmit location updates.<br/><br/>Each tag can be fully customized with your company logo using high-precision UV printing. This means you are not only tracking shipments in real time, but also delivering a premium branded experience.<br/>Whether used for logistics control, internal tracking, or as a high-value corporate gift, StellarTag combines powerful technology and affordable scalability without complicated systems or subscriptions.</p>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "center",
