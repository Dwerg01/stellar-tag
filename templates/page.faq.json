              "blocks": {
                "text_qFY7JT": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Stellar Tag is a compact, Apple-compatible tracking device that helps businesses and individuals monitor valuable shipments and belongings using the Apple iCloud tracking network. It offers real-time visibility whenever an Apple device is nearby.</p>",
