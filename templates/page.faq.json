                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_ceLepj": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Simply activate the tag, attach it to your shipment or item, and track it using Apple’s Find My app. The tag updates its location through nearby Apple devices, giving you instant and reliable visibility.</p>",
